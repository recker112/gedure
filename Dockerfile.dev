# syntax=docker/dockerfile:1
#
# Imagen de DESARROLLO de Gedure. Mismo runtime que Dockerfile.prod
# (FrankenPHP + PHP 8.5 Alpine, mismas extensiones) más lo que en producción
# no entra: composer, git y unzip. El código NO se copia: docker-compose.yml
# monta ./backend en /var/www y el contenedor corre con el UID del host.
# Contexto de build = raíz del repo.
FROM dunglas/frankenphp:1-php8.5-alpine

# mariadb-client: solo comodidad de dev (cliente `mariadb` para depurar desde
# el contenedor); producción no lo lleva. git/unzip: los usa composer.
RUN apk add --no-cache git unzip bash mariadb-client

# Mismas extensiones que Dockerfile.prod (ver los motivos allí). opcache ya
# viene en el núcleo de PHP 8.5.
RUN install-php-extensions pdo_mysql pcntl

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# El contenedor corre con un UID sin entrada en /etc/passwd ni $HOME: todo lo
# que necesita escribir fuera de /var/www va a /tmp.
ENV HOME=/tmp \
    COMPOSER_HOME=/tmp/composer \
    XDG_CONFIG_HOME=/tmp/caddy/config \
    XDG_DATA_HOME=/tmp/caddy/data

COPY docker/dev/php.ini "$PHP_INI_DIR/conf.d/zz-gedure.ini"
COPY docker/dev/Caddyfile /etc/caddy/Caddyfile
COPY docker/dev/entrypoint.sh /usr/local/bin/entrypoint.sh
# chmod aquí y no en el host: en un checkout de Windows el bit se pierde.
RUN chmod +x /usr/local/bin/entrypoint.sh \
 && mkdir -p /tmp/caddy/config /tmp/caddy/data \
 && chmod -R 777 /tmp/caddy

WORKDIR /var/www

# Puertos altos: sin root no se puede enlazar 80/443. El compose los publica
# como ${APP_PORT:-80}:8000 y ${APP_SSL_PORT:-443}:8443.
EXPOSE 8000 8443

# La base sondea el admin API de Caddy (:2019), que aquí está off.
HEALTHCHECK --interval=10s --timeout=5s --start-period=600s --retries=5 \
  CMD wget -q -O /dev/null -T 4 http://127.0.0.1:8000/up || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["web"]
