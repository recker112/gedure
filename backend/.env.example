APP_NAME="La Candelaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Servicio `db` del docker-compose.yml raíz (MariaDB 11.4). DB_DATABASE y
# DB_PASSWORD deben coincidir con los del .env raíz (por defecto gedure/secret).
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gedure
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (servicio `reverb` del compose, `php artisan reverb:start` en :8080).
# REVERB_HOST/PORT/SCHEME: a dónde PUBLICA Laravel los eventos (API HTTP de
# Reverb), por la red interna de Docker; no pasa por Caddy.
# REVERB_APP_KEY=LAC4ANDE47 es la key fija que usa el frontend React
# (frontend/src/hooks/useSockets.js). Valores de desarrollo: en producción
# usa un id/secret propios.
REVERB_APP_ID=gedure
REVERB_APP_KEY=LAC4ANDE47
REVERB_APP_SECRET=gedure-dev-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Cliente (Echo, resources/js/echo.js): el navegador entra por Caddy en
# /app (http://localhost o https://localhost), que hace proxy a reverb:8080.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http
