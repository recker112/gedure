# Contexto de build = raíz del repo (monorepo backend/ + frontend/).
# Lo usan Dockerfile.prod y Dockerfile.dev (este último solo copia docker/dev/).

# Control de versiones y CI
.git
.github
**/.gitignore
**/.gitattributes
README.md
**/README.md

# Stack de desarrollo y archivos Docker (no entran en la imagen)
Dockerfile*
docker-compose*
.dockerignore
docker/dbdata
docker/caddy

# Dependencias: se instalan dentro del build. `vendor` a secas solo
# coincidiría con ./vendor; con ** cubre backend/vendor.
**/node_modules

# Certificados locales de mkcert (frontend/certs incluye la clave privada de la CA)
**/certs
**/vendor

# Builds locales: el del frontend se hace en la etapa de Node y sus artefactos
# en backend/ (si alguien los copió a mano) no deben pisar los del build.
backend/public/build
backend/public/hot
backend/public/storage
backend/public/assets
backend/public/index.html
backend/public/favicon.svg
backend/public/icons.svg
backend/resources/views/app.blade.php

# Estado runtime y uploads locales de Laravel
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing
backend/storage/app/*
backend/storage/*.key
backend/storage/pail
backend/database/*.sqlite*
backend/bootstrap/cache/*.php
backend/.phpunit.result.cache

# Secretos
**/.env
**/.env.*
!**/.env.example

# Tests y herramientas de desarrollo
backend/tests
backend/phpunit.xml

# Basura de sistema/editor
**/.DS_Store
**/*.log
**/*.map
.vscode
.idea
*.swp
