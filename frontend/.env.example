# Variables públicas del cliente (Vite las incrusta en el JS al compilar; nunca
# pongas secretos). Copia este archivo a .env para desarrollo local.

# Debe coincidir con REVERB_APP_KEY del backend (backend/.env.example).
VITE_REVERB_APP_KEY="LAC4ANDE47"
# Reverb lo atiende Caddy en /app del mismo host de la app (80/443 en dev).
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="80"
VITE_REVERB_SCHEME="http"
