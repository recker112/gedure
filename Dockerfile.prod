# syntax=docker/dockerfile:1
#
# Imagen única de producción de Gedure: ghcr.io/<owner>/gedure
# (el nombre sale de `ghcr.io/${{ github.repository }}` en
# .github/workflows/built_image.yml).
#
# Una sola imagen sirve TODOS los procesos de la app; el rol se elige en
# runtime con el argumento del entrypoint (ver docker/prod/entrypoint.sh):
#   web (por defecto) | reverb | worker | schedule
#
# Backend: Laravel 13 + Sanctum + Reverb. Frontend: Vite + React (frontend/).
#
# Contexto de build = raíz del repo (monorepo: backend/ + frontend/).

# ═══════════════════════════════════════════════════════════════════════
# ETAPA 1: build del frontend (Vite + React con React Compiler)
# ═══════════════════════════════════════════════════════════════════════
FROM node:22-alpine AS frontend

# Variables públicas de cliente que Vite incrusta EN TIEMPO DE BUILD (no se
# leen en runtime). Nunca deben ir aquí secretos de servidor. Sin valor, el
# build compila igual (import.meta.env.VITE_* queda undefined).
ARG VITE_REVERB_APP_KEY
ENV VITE_REVERB_APP_KEY=${VITE_REVERB_APP_KEY}

WORKDIR /app

# Dependencias en su propia capa: solo se invalida al cambiar el lockfile.
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci --no-audit --no-fund

# frontend/vite.config.js fija `build.outDir: '../backend/public'`, fuera de
# frontend/: el build escribe en /app/backend/public (assets e index.html) y
# mueve index.html a /app/backend/resources/views/app.blade.php, que debe
# existir de antemano como directorio. No se copia el PHP a esta etapa: así un
# cambio solo de backend no invalida la caché del build del frontend.
COPY frontend/ ./frontend/
RUN mkdir -p backend/public backend/resources/views \
 && cd frontend && npm run build

# El movimiento lo hace vite.config.js de forma síncrona; aquí se garantiza de
# forma determinista (idempotente) y se verifica el resultado.
RUN if [ -f backend/public/index.html ]; then \
      mv backend/public/index.html backend/resources/views/app.blade.php; \
    fi \
 && test -f backend/resources/views/app.blade.php \
 && test -n "$(ls backend/public/assets/*.js 2>/dev/null)"

# ═══════════════════════════════════════════════════════════════════════
# Base PHP: runtime + extensiones, compartida por vendor y producción
# ═══════════════════════════════════════════════════════════════════════
# PHP 8.5 (FrankenPHP 1.x).
FROM dunglas/frankenphp:1-php8.5-alpine AS php-base

# - su-exec: bajar de root al usuario de la app en el entrypoint.
# Sin cliente de base de datos: el ping de arranque va por PDO
# (docker/prod/wait-for-db.php) y ya no hay backups con mysqldump.
RUN apk add --no-cache su-exec

# Extensiones que no trae la base:
#   - pdo_mysql: Eloquent contra MariaDB (drivers mysql/mariadb).
#   - pcntl: señales de queue:work (--max-time, apagado limpio) y de
#     reverb:start (parada/reinicio limpios).
# Todo lo que exige composer.lock (ctype, curl, dom, fileinfo, filter, hash,
# iconv, json, mbstring, openssl, pcre, session, tokenizer) ya viene en la base
# (`composer check-platform-reqs --no-dev` en la etapa vendor lo comprueba).
# opcache no se instala: desde PHP 8.5 es parte del núcleo y ya viene cargado.
RUN install-php-extensions \
      pdo_mysql \
      pcntl

# ═══════════════════════════════════════════════════════════════════════
# ETAPA 2: dependencias PHP (Composer solo vive aquí)
# ═══════════════════════════════════════════════════════════════════════
FROM php-base AS vendor

WORKDIR /app
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY backend/composer.json backend/composer.lock ./
RUN composer install \
      --no-dev --no-scripts --no-autoloader \
      --prefer-dist --no-interaction --no-progress

COPY backend/ ./
# Con scripts: post-autoload-dump ejecuta `package:discover`, que genera
# bootstrap/cache/{packages,services}.php (se copian a la imagen final).
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative \
 && composer check-platform-reqs --no-dev \
 && test -f bootstrap/cache/packages.php

# ═══════════════════════════════════════════════════════════════════════
# ETAPA 3: imagen final
# ═══════════════════════════════════════════════════════════════════════
FROM php-base AS production

# Versión desplegada (tag de git), la pasa el CI.
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}

# Caddy (embebido en FrankenPHP) guarda config/estado en XDG_*; la imagen base
# ya apunta a /config y /data. Deben ser escribibles por el usuario de la app.
ENV XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data

WORKDIR /var/www

COPY docker/prod/php.ini "$PHP_INI_DIR/conf.d/zz-gedure.ini"
COPY docker/prod/Caddyfile /etc/frankenphp/Caddyfile

# El código queda de root y de solo lectura para la app; solo storage/,
# bootstrap/cache y el propio directorio public/ (para el symlink de
# storage:link) pasan a www-data más abajo.
# Los assets Vite de Laravel (resources/js, resources/css) NO se compilan: la
# vista welcome solo los carga si existe public/build/manifest.json, y el
# frontend real es el build de React. Si algún día se usan vistas con @vite,
# añadir una etapa `npm ci && npm run build` sobre backend/.
COPY backend/ ./
COPY --from=vendor /app/vendor ./vendor
COPY --from=vendor /app/bootstrap/cache ./bootstrap/cache
# backend/public conserva index.php/.htaccess/robots.txt (esqueleto de Laravel);
# el build de Vite (assets/, favicon.svg, icons.svg) se superpone encima.
COPY --from=frontend /app/backend/public/ ./public/
COPY --from=frontend /app/backend/resources/views/app.blade.php ./resources/views/app.blade.php

COPY docker/prod/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/prod/wait-for-db.php /usr/local/bin/wait-for-db.php
COPY docker/prod/healthcheck.sh /usr/local/bin/healthcheck.sh

# chmod +x aquí y no en el host: en un checkout de Windows el bit se pierde.
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh \
 && test -f resources/views/app.blade.php \
 && mkdir -p /config/caddy /data/caddy \
 && chown -R www-data:www-data /config /data storage bootstrap/cache \
 && chown www-data:www-data public \
 # Copia de referencia: si el volumen de storage/ llega vacío (primer
 # despliegue) el entrypoint restaura la estructura desde aquí.
 && cp -a /var/www/storage /var/www/storage_defaults

EXPOSE 80

# La imagen base sondea el admin API de Caddy (:2019), que aquí está
# deshabilitado (`admin off`). El script decide según el rol del contenedor:
# web -> GET /up ; reverb -> puerto 8080 ; worker/schedule -> siempre ok
# (si el proceso muere, el contenedor sale y Docker lo reinicia).
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["/usr/local/bin/healthcheck.sh"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["web"]
