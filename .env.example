# Compose de desarrollo (docker-compose.yml). Copiar a .env solo si hay que cambiar algo.
DB_DATABASE=gedure
DB_PASSWORD=secret

# UID/GID del host para que vendor/ y storage/ no queden como root:
#   id -u  /  id -g
# En Windows no hay `id`: deja los valores por defecto.
HOST_UID=1000
HOST_GID=1000

# Interfaz de publicación. 127.0.0.1 = solo esta máquina; 0.0.0.0 = toda la LAN
# (Docker salta ufw).
BIND_ADDR=127.0.0.1

# Puertos publicados. 80/443 dan http(s)://localhost sin puerto; el frontend
# local (npm start con REACT_APP_BACKEND=localhost, WebSockets en 80/443) los
# necesita así. Cambiarlos solo si están ocupados, y entonces la app se abre por
# ese puerto pero el SPA de :3000 deja de encontrar la API/WebSockets.
APP_PORT=80
APP_SSL_PORT=443
ADMINER_PORT=8080

# true = migrate en cada arranque de la app (por defecto, a mano).
RUN_COMMANDS=false
